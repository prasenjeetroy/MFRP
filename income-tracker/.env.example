# Copy this file to ".env" and fill in your values. Never commit .env.

# ---- Web server ----
PORT=3000
NODE_ENV=development

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# ---- SQL Server ----
DB_SERVER=localhost
DB_DATABASE=IncomeTracker
DB_USER=sa
DB_PASSWORD=your-sql-password

# Use EITHER a port (default instance, or a named instance with a fixed port)...
DB_PORT=1433
# ...OR an instance name such as SQLEXPRESS (needs the "SQL Server Browser" service running).
# When DB_INSTANCE is set, DB_PORT is ignored.
# DB_INSTANCE=SQLEXPRESS

# Local SQL Server uses a self-signed certificate, so trust it in development.
# For Azure SQL set DB_ENCRYPT=true and DB_TRUST_CERT=false.
DB_ENCRYPT=true
DB_TRUST_CERT=true
